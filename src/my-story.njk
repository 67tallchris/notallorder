---
title: My Story | No Tall Order
description: "Over a decade of hands-on marketing across a dozen industries and every channel — and why I'm now building a fractional CMO practice for established businesses."
---
{% extends "base.njk" %}
{% block styles %}
.timeline { max-width: 840px; margin: 0 auto; position: relative; }
.timeline .fx-journey-canvas {
  position: absolute; inset: 0; width: 100%; height: 100%;
  display: block; pointer-events: none; z-index: 0;
}
.story-item {
  display: grid; grid-template-columns: 96px 1fr; gap: 2.25rem;
  position: relative; z-index: 1;
}
.story-year {
  font-size: 16px; font-weight: 900; color: #848789;
  letter-spacing: -0.2px; text-align: right; padding-top: 1px; line-height: 1.35;
  transition: color 0.6s ease;
}
.story-item.lit .story-year { color: #004B8C; }
/* Hide CSS fallback dots and line when Three.js journey is active */
.timeline.fx-journey-active .story-body::before,
.timeline.fx-journey-active .story-body::after { display: none; }
.story-body {
  position: relative; padding-left: 2.5rem; padding-bottom: 3rem;
}
.story-item:last-child .story-body { padding-bottom: 0; }
/* connecting line */
.story-body::before {
  content: ""; position: absolute; left: 5px; top: 9px; bottom: -3px;
  width: 2px; background: #dddbd4;
}
.story-item:last-child .story-body::before { display: none; }
/* node */
.story-body::after {
  content: ""; position: absolute; left: 0; top: 4px;
  width: 12px; height: 12px; border-radius: 50%;
  background: #004B8C; box-shadow: 0 0 0 4px #f5f4f1;
}
.story-body h3 {
  font-size: 21px; font-weight: 700; color: #272E33;
  margin-bottom: 0.65rem; line-height: 1.3;
}
.story-body p {
  font-family: "Aleo", serif; font-size: 17px;
  line-height: 1.8; color: #5f6264;
}

/* throughlines */
.throughlines { background: #fff; border-top: 1px solid #dddbd4; }
.throughlines-inner { max-width: 1100px; margin: 0 auto; padding: 5rem 2.5rem; }
.throughlines h2 {
  font-size: 28px; font-weight: 700; color: #272E33;
  letter-spacing: -0.3px; margin-bottom: 2rem; text-align: center;
}
.tl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.tl-card {
  background: #f5f4f1; border: 1px solid #dddbd4;
  border-radius: 12px; padding: 1.75rem 2rem;
}
.tl-card h4 {
  font-size: 17px; font-weight: 700; color: #004B8C; margin-bottom: 0.6rem;
}
.tl-card p {
  font-family: "Aleo", serif; font-size: 16px;
  line-height: 1.7; color: #5f6264;
}

@media (max-width: 760px) {
  .tl-grid { grid-template-columns: 1fr; }
  .throughlines-inner { padding: 3.5rem 1.25rem; }
}
@media (max-width: 600px) {
  .story-item { grid-template-columns: 1fr; gap: 0.4rem; }
  .story-year { text-align: left; }
  .story-body { padding-left: 1.5rem; }
}
{% endblock %}

{% block content %}
<div class="page-header">
  <div class="page-header-inner">
    <div class="eyebrow"><span class="eyebrow-dot"></span>{{ story.eyebrow }}</div>
    <h1>{{ story.headline | safe }}</h1>
    <p class="sub">{{ story.subheading }}</p>
  </div>
</div>

<div class="section">
  <div class="timeline">
    {% for m in story.milestones %}
    <div class="story-item">
      <div class="story-year">{{ m.year }}</div>
      <div class="story-body">
        <h3>{{ m.title }}</h3>
        <p>{{ m.description }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="throughlines">
  <div class="throughlines-inner">
    <h2>{{ story.throughlines.headline }}</h2>
    <div class="tl-grid">
      {% for item in story.throughlines.items %}
      <div class="tl-card">
        <h4>{{ item.title }}</h4>
        <p>{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="cta-band">
  <h2>{{ story.cta.headline }}</h2>
  <p>{{ story.cta.subheading }}</p>
  <a href="{{ story.cta.button_href }}" class="btn-p">{{ story.cta.button_text }}</a>
</div>
{% endblock %}
{% block scripts %}{% endblock %}
