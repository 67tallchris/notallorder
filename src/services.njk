---
title: Services | No Tall Order
layout: base.njk
---
{% block styles %}
.service-card {
  background: #fff; border-radius: 12px;
  border: 1px solid #dddbd4;
  border-left: 4px solid var(--accent);
  padding: 2rem 2.5rem;
  display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
  align-items: start;
}
.service-card + .service-card { margin-top: 1.25rem; }
.sc-category {
  font-size: 12px; font-weight: 500; letter-spacing: 0.16em;
  text-transform: uppercase; color: #848789; margin-bottom: 0.5rem;
}
.sc-title { font-size: 26px; font-weight: 700; color: #272E33; margin-bottom: 1rem; }
.sc-desc { font-family: "Aleo", serif; font-size: 17px; line-height: 1.75; color: #848789; }
.sc-deliverables { margin-top: 0; }
.sc-deliverables h4 {
  font-size: 12px; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: #272E33; margin-bottom: 0.75rem;
}
.sc-deliverables ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
.sc-deliverables li {
  display: flex; align-items: center; gap: 10px;
  font-family: "Aleo", serif; font-size: 16px; color: #848789;
}
.sc-deliverables li::before {
  content: ""; width: 6px; height: 6px; border-radius: 50%;
  background: var(--accent); flex-shrink: 0;
}
{% endblock %}

{% block content %}
<div class="page-header">
  <div class="page-header-inner">
    <div class="eyebrow"><span class="eyebrow-dot"></span>{{ services.eyebrow }}</div>
    <h1>{{ services.headline | safe }}</h1>
    <p class="sub">{{ services.subheading }}</p>
  </div>
</div>

<div class="section">
  {% for item in services.items %}
  <div class="service-card" style="--accent: {{ item.color }}">
    <div>
      <div class="sc-category">{{ item.category }}</div>
      <div class="sc-title">{{ item.title }}</div>
      <p class="sc-desc">{{ item.description }}</p>
    </div>
    <div class="sc-deliverables">
      <h4>What you get</h4>
      <ul>
        {% for d in item.deliverables %}
        <li>{{ d }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endfor %}
</div>

<div class="cta-band">
  <h2>{{ services.cta.headline }}</h2>
  <p>{{ services.cta.subheading }}</p>
  <a href="{{ services.cta.button_href }}" class="btn-p">{{ services.cta.button_text }}</a>
</div>
{% endblock %}
