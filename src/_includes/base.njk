<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<style>
@import url('https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700;900&family=Aleo:wght@400;700&display=swap');
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Red Hat Display", sans-serif; background: #f5f4f1; }

/* ── Nav ── */
nav {
  display: flex; justify-content: space-between; align-items: center;
  padding: 11px 2.5rem; background: #fff;
  border-bottom: 1px solid #dddbd4;
}
.logo img { height: 54px; width: auto; }
.nav-links { display: flex; gap: 2rem; list-style: none; }
.nav-links a { font-size: 15px; color: #848789; text-decoration: none; font-weight: 500; letter-spacing: 0.03em; }
.nav-links a.active { color: #004B8C; }
.nav-cta {
  background: #004B8C; color: #fff; font-size: 15px; font-weight: 700;
  padding: 11px 24px; border-radius: 6px; text-decoration: none; letter-spacing: 0.03em;
}

/* ── Shared components ── */
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: #e8eef5; color: #004B8C;
  font-size: 13px; font-weight: 500; letter-spacing: 0.18em;
  text-transform: uppercase; padding: 6px 14px;
  border-radius: 100px; margin-bottom: 1.5rem;
}
.eyebrow-dot { width: 6px; height: 6px; background: #004B8C; border-radius: 50%; }

.btn-p {
  background: #004B8C; color: #fff;
  font-size: 17px; font-weight: 700; padding: 15px 30px;
  border-radius: 6px; text-decoration: none; display: inline-block;
}
.btn-s {
  color: #272E33; font-size: 17px; font-weight: 500;
  text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
}
.btn-s .arr { color: #004B8C; font-size: 22px; }

/* ── Inner page header ── */
.page-header {
  background: #fff; border-bottom: 1px solid #dddbd4;
  padding: 4rem 2.5rem 3.5rem;
}
.page-header-inner { max-width: 1100px; margin: 0 auto; max-width: 660px; }
.page-header h1 {
  font-size: 46px; font-weight: 700; line-height: 1.1;
  letter-spacing: -0.5px; color: #272E33; margin-bottom: 1rem;
}
.page-header h1 em { font-style: normal; color: #004B8C; }
.page-header .sub {
  font-family: "Aleo", serif; font-size: 20px;
  line-height: 1.75; color: #848789;
}

/* ── Section wrapper ── */
.section {
  max-width: 1100px; margin: 0 auto;
  padding: 3.5rem 2.5rem;
}

/* ── CTA band ── */
.cta-band {
  background: #004B8C; padding: 4.5rem 2.5rem;
  text-align: center; margin-top: 1rem;
}
.cta-band h2 {
  font-size: 36px; font-weight: 700; color: #fff;
  letter-spacing: -0.3px; margin-bottom: 0.75rem;
}
.cta-band p {
  font-family: "Aleo", serif; font-size: 20px;
  color: rgba(255,255,255,0.75); margin-bottom: 2rem;
}
.cta-band .btn-p { background: #fff; color: #004B8C; }

{% block styles %}{% endblock %}
</style>
</head>
<body>

<nav>
  <div class="logo">
    <a href="/"><img src="/assets/logo.png" alt="{{ site.nav.logo_alt }}"></a>
  </div>
  <ul class="nav-links">
    {% for link in site.nav.links %}
    <li><a href="{{ link.href }}" {% if page.url == link.href %}class="active"{% endif %}>{{ link.label }}</a></li>
    {% endfor %}
  </ul>
  <a href="{{ site.nav.cta_href }}" class="nav-cta">{{ site.nav.cta_text }}</a>
</nav>

{% block content %}{% endblock %}

</body>
</html>
