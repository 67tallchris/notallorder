<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description or site.meta.default_description }}">
<link rel="canonical" href="https://notallorder.com{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="No Tall Order">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or site.meta.default_description }}">
<meta property="og:url" content="https://notallorder.com{{ page.url }}">
<meta property="og:image" content="https://notallorder.com/assets/og-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description or site.meta.default_description }}">
<meta name="twitter:image" content="https://notallorder.com/assets/og-card.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700;900&family=Aleo:wght@400;700&display=swap">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Red Hat Display", sans-serif; background: #f5f4f1; }

/* ── Polish: selection, focus, page transitions ── */
::selection { background: #004B8C; color: #fff; }
:focus-visible { outline: 2px solid #004B8C; outline-offset: 3px; border-radius: 4px; }
@view-transition { navigation: auto; }
html { scroll-behavior: smooth; }

/* ── Shared scroll-reveal states (applied by JS only) ── */
.fx-pre { opacity: 0; transform: translateY(20px); }
.fx-in {
  opacity: 1; transform: none;
  transition: opacity 0.7s ease, transform 0.7s ease;
  transition-delay: var(--fx-delay, 0s);
}

/* ── Nav ── */
nav {
  display: flex; justify-content: space-between; align-items: center;
  padding: 11px 2.5rem; background: #fff;
  border-bottom: 1px solid #dddbd4;
}
.logo img { height: 54px; width: auto; }
.nav-links { display: flex; gap: 2rem; list-style: none; }
.nav-links a {
  font-size: 15px; color: #848789; text-decoration: none; font-weight: 500; letter-spacing: 0.03em;
  transition: color 0.2s ease;
}
.nav-links a:hover { color: #272E33; }
.nav-links a.active { color: #004B8C; }
.nav-cta {
  background: #004B8C; color: #fff; font-size: 15px; font-weight: 700;
  padding: 11px 24px; border-radius: 6px; text-decoration: none; letter-spacing: 0.03em;
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-cta:hover {
  background: #003566; transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(0, 75, 140, 0.25);
}

/* ── Shared components ── */
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: #e8eef5; color: #004B8C;
  font-size: 13px; font-weight: 500; letter-spacing: 0.18em;
  text-transform: uppercase; padding: 6px 14px;
  border-radius: 100px; margin-bottom: 1.5rem;
}
.eyebrow-dot { width: 6px; height: 6px; background: #004B8C; border-radius: 50%; }

.btn-p {
  background: #004B8C; color: #fff;
  font-size: 17px; font-weight: 700; padding: 15px 30px;
  border-radius: 6px; text-decoration: none; display: inline-block;
  transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}
.btn-p:hover {
  background: #003566; transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0, 75, 140, 0.25);
}
.btn-s {
  color: #272E33; font-size: 17px; font-weight: 500;
  text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
  transition: color 0.2s ease;
}
.btn-s:hover { color: #004B8C; }
.btn-s .arr { color: #004B8C; font-size: 22px; transition: transform 0.2s ease; }
.btn-s:hover .arr { transform: translateX(4px); }

/* ── Inner page header ── */
.page-header {
  background: #fff; border-bottom: 1px solid #dddbd4;
  padding: 6rem 2.5rem 5rem;
}
.page-header-inner { max-width: 1100px; margin: 0 auto; }
.page-header h1 {
  font-size: clamp(32px, 5.5vw, 46px); font-weight: 700; line-height: 1.12;
  letter-spacing: -0.5px; color: #272E33; margin-bottom: 1.5rem; max-width: 720px;
}
.page-header h1 em { font-style: normal; color: #004B8C; }
.page-header .sub {
  font-family: "Aleo", serif; font-size: 20px;
  line-height: 1.8; color: #848789; max-width: 620px;
}

/* ── Section wrapper ── */
.section {
  max-width: 1100px; margin: 0 auto;
  padding: 6rem 2.5rem;
}

/* ── CTA band ── */
.cta-band {
  background: #004B8C; padding: 6.5rem 2.5rem;
  text-align: center;
}
.cta-band h2 {
  font-size: 36px; font-weight: 700; color: #fff;
  letter-spacing: -0.3px; margin-bottom: 1rem;
}
.cta-band p {
  font-family: "Aleo", serif; font-size: 20px;
  color: rgba(255,255,255,0.75); margin-bottom: 2.5rem;
  max-width: 560px; margin-left: auto; margin-right: auto;
}
.cta-band .btn-p { background: #fff; color: #004B8C; }
.cta-band .btn-p:hover { background: #e8eef5; }

/* ── Entrance animation (hero + page headers) ── */
@media (prefers-reduced-motion: no-preference) {
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }
  .hero > div:first-child > *,
  .page-header-inner > * {
    animation: fadeUp 0.65s ease both;
  }
  .hero > div:first-child > *:nth-child(2),
  .page-header-inner > *:nth-child(2) { animation-delay: 0.08s; }
  .hero > div:first-child > *:nth-child(3),
  .page-header-inner > *:nth-child(3) { animation-delay: 0.16s; }
  .hero > div:first-child > *:nth-child(4) { animation-delay: 0.24s; }
  .hero > div:first-child > *:nth-child(5) { animation-delay: 0.32s; }
  .hero-right { animation: fadeUp 0.65s ease 0.2s both; }
}

/* ── Footer ── */
footer {
  background: #fff; border-top: 1px solid #dddbd4;
  padding: 4.5rem 2.5rem 3rem;
}
.footer-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 2rem; flex-wrap: wrap;
}
.footer-brand img { height: 44px; width: auto; margin-bottom: 0.75rem; }
.footer-tagline {
  font-family: "Aleo", serif; font-size: 14px; color: #848789;
  max-width: 280px; line-height: 1.6;
}
.footer-links { display: flex; gap: 2rem; list-style: none; flex-wrap: wrap; }
.footer-links a {
  font-size: 14px; color: #848789; text-decoration: none; font-weight: 500;
  transition: color 0.2s ease;
}
.footer-links a:hover { color: #004B8C; }
.footer-bottom {
  max-width: 1100px; margin: 2rem auto 0;
  padding-top: 1.25rem; border-top: 1px solid #dddbd4;
  display: flex; justify-content: space-between; align-items: center;
  gap: 1rem; flex-wrap: wrap;
}
.footer-copy { font-size: 13px; color: #848789; }
.footer-cta-link {
  font-size: 14px; font-weight: 700; color: #004B8C; text-decoration: none;
  display: inline-flex; align-items: center; gap: 5px;
  transition: gap 0.2s ease;
}
.footer-cta-link:hover { gap: 9px; }

/* ── Responsive ── */
@media (max-width: 760px) {
  nav { flex-wrap: wrap; padding: 10px 1.25rem; row-gap: 4px; }
  .logo img { height: 44px; }
  .nav-links {
    order: 3; width: 100%; justify-content: center;
    gap: 1.25rem; padding: 8px 0 4px;
  }
  .nav-links a { font-size: 14px; }
  .nav-cta { font-size: 13px; padding: 9px 16px; }
  .page-header { padding: 3rem 1.25rem 2.5rem; }
  .section { padding: 2.5rem 1.25rem; }
  .cta-band { padding: 3.5rem 1.25rem; }
  .cta-band h2 { font-size: 28px; }
  footer { padding: 2.5rem 1.25rem 1.5rem; }
}

{% block styles %}{% endblock %}
</style>
</head>
<body>

<nav>
  <div class="logo">
    <a href="/"><img src="/assets/logo.png" alt="{{ site.nav.logo_alt }}"></a>
  </div>
  <ul class="nav-links">
    {% for link in site.nav.links %}
    <li><a href="{{ link.href }}" {% if page.url == link.href %}class="active"{% endif %}>{{ link.label }}</a></li>
    {% endfor %}
  </ul>
  <a href="{{ site.nav.cta_href }}" class="nav-cta">{{ site.nav.cta_text }}</a>
</nav>

{% block content %}{% endblock %}

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/"><img src="/assets/logo.png" alt="{{ site.nav.logo_alt }}"></a>
      <p class="footer-tagline">{{ site.footer.tagline }}</p>
    </div>
    <ul class="footer-links">
      {% for link in site.nav.links %}
      <li><a href="{{ link.href }}">{{ link.label }}</a></li>
      {% endfor %}
      <li><a href="{{ site.nav.cta_href }}">Contact</a></li>
    </ul>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">{{ site.footer.copyright }}</span>
    <a href="{{ site.nav.cta_href }}" class="footer-cta-link">{{ site.nav.cta_text }} <span>→</span></a>
  </div>
</footer>

<script type="module">
  // Progressive enhancement: dynamic 3D/motion layer.
  // Skipped for reduced-motion users; loaded after the page is fully rendered.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (document.readyState === 'complete') import('/js/fx/init.js');
    else addEventListener('load', () => import('/js/fx/init.js'), { once: true });
  }
</script>
{% block scripts %}{% endblock %}

</body>
</html>
