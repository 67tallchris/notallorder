---
title: No Tall Order | Fractional CMO for Established Businesses
description: "Fractional CMO for established businesses. You've proven your model — now get clear on who your next customer is and build the strategy to reach them."
---
{% extends "base.njk" %}
{% block styles %}
.hero {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 3rem; align-items: center;
  padding: 5rem 2.5rem 4rem; max-width: 1100px; margin: 0 auto;
}
h1 {
  font-size: clamp(34px, 6.5vw, 54px); font-weight: 700; line-height: 1.1;
  letter-spacing: -0.5px; color: #272E33; margin-bottom: 1.25rem;
}
h1 em { font-style: normal; color: #004B8C; }
.sub {
  font-family: "Aleo", serif;
  font-size: 20px; line-height: 1.75; color: #848789;
  margin-bottom: 2rem; max-width: 440px;
}
.btns { display: flex; gap: 1rem; align-items: center; margin-bottom: 2.5rem; }
.trust {
  display: flex; gap: 2rem; align-items: flex-start;
  padding-top: 1.5rem; border-top: 1px solid #dddbd4;
}
.trust-item { display: flex; flex-direction: column; gap: 3px; }
.trust-num { font-size: 24px; font-weight: 900; color: #272E33; letter-spacing: -0.5px; white-space: nowrap; }
.trust-num span { color: #004B8C; }
.trust-label { font-family: "Aleo", serif; font-size: 14px; color: #848789; }
.trust-div { width: 1px; height: 36px; background: #dddbd4; }
.hero-right { display: flex; flex-direction: column; gap: 1.25rem; align-items: center; }
.logo-card {
  border-radius: 16px;
  overflow: hidden;
  width: 100%;
}
.logo-card img { width: 100%; height: 320px; object-fit: cover; object-position: top; display: block; }
.service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.sc {
  background: #fff; border-radius: 10px;
  border: 1px solid #dddbd4; padding: 14px 16px;
}
.sc .sc-bar { transform-origin: left; transition: transform 0.8s ease 0.35s; }
.sc.fx-pre .sc-bar { transform: scaleX(0); }
.sc.fx-in .sc-bar { transform: scaleX(1); }
.sc-label {
  font-size: 12px; font-weight: 500; letter-spacing: 0.16em;
  text-transform: uppercase; color: #848789; margin-bottom: 4px;
}
.sc-title { font-size: 15px; font-weight: 700; color: #272E33; margin-bottom: 3px; }
.sc-desc { font-family: "Aleo", serif; font-size: 14px; color: #848789; line-height: 1.5; }
.sc-bar { height: 3px; border-radius: 2px; margin-top: 10px; }
.stats-bar { background: #004B8C; padding: 1.25rem 2.5rem; }
.stats-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; align-items: flex-start;
}
.stat-item {
  flex: 1; text-align: center; padding: 0.5rem 0;
  border-right: 1px solid rgba(255,255,255,0.15);
}
.stat-item:last-child { border-right: none; }
.stat-num { font-size: 20px; font-weight: 900; color: #fff; letter-spacing: -0.3px; }
.stat-num span { color: #7196BD; }
.stat-lbl { font-family: "Aleo", serif; font-size: 13px; color: rgba(255,255,255,0.55); margin-top: 2px; }

@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; padding: 3rem 1.25rem 2.5rem; gap: 2.5rem; }
  .sub { max-width: none; }
  .trust { flex-wrap: wrap; gap: 1.25rem; }
  .trust-div { display: none; }
}
@media (max-width: 760px) {
  .stats-bar { padding: 1.25rem; }
  .stats-inner { flex-wrap: wrap; }
  .stat-item { flex: 1 1 50%; padding: 0.75rem 0.5rem; }
  .stat-item:nth-child(2) { border-right: none; }
}
@media (max-width: 560px) {
  .btns { flex-direction: column; align-items: flex-start; }
  .service-grid { grid-template-columns: 1fr; }
  .stat-item { flex: 1 1 100%; border-right: none; }
}
{% endblock %}

{% block content %}
<div class="hero">
  <div>
    <div class="eyebrow"><span class="eyebrow-dot"></span>{{ site.hero.eyebrow }}</div>
    <h1>{{ site.hero.headline | safe }}</h1>
    <p class="sub">{{ site.hero.subheading }}</p>
    <div class="btns">
      <a href="{{ site.hero.primary_cta_href }}" class="btn-p">{{ site.hero.primary_cta_text }}</a>
      <a href="{{ site.hero.secondary_cta_href }}" class="btn-s">{{ site.hero.secondary_cta_text }} <span class="arr">→</span></a>
    </div>
    <div class="trust">
      {% for item in site.hero.trust_items %}
      <div class="trust-item">
        <div class="trust-num">{{ item.number | safe }}</div>
        <div class="trust-label">{{ item.label }}</div>
      </div>
      {% if not loop.last %}<div class="trust-div"></div>{% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="hero-right">
    <div class="logo-card">
      <img src="/assets/profile.jpg" alt="{{ site.profile.alt }}">
    </div>
    <div class="service-grid">
      {% for svc in site.services %}
      <div class="sc">
        <div class="sc-label">{{ svc.category }}</div>
        <div class="sc-title">{{ svc.title }}</div>
        <div class="sc-desc">{{ svc.description }}</div>
        <div class="sc-bar" style="background:{{ svc.color }}"></div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="stats-bar">
  <div class="stats-inner">
    {% for stat in site.stats %}
    <div class="stat-item">
      <div class="stat-num">{{ stat.value | safe }}</div>
      <div class="stat-lbl">{{ stat.label }}</div>
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
